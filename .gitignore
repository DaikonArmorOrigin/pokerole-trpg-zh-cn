# ============================================================
#  .gitignore —— 哪些文件不进仓库
#  规则：只有「网站本身需要的东西」才提交，
#        工具缓存、备份、临时文件一律不提交。
# ============================================================

# 工具与备份（AI 助手的工作目录，体积大且与站点无关）
.workbuddy-ai/
.workbuddy/

# 编辑器 / 系统杂项
.DS_Store
Thumbs.db
desktop.ini
.vscode/
~$*

# 临时备份与日志
*.bak
*.tmp
*.log

# Python（serve.py 运行时可能生成）
__pycache__/
*.pyc
